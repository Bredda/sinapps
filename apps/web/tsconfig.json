{
  "extends": "@sinapps/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@sinapps/ui/*": ["../../packages/ui/src/*"]
    },
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "instrumentation.ts", "vite.config.ts", "paraglide.config.ts", "vitest.config.ts"]
}
