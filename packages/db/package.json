{
  "name": "@sinapps/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./parts": "./src/parts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --adapter drizzle --dialect postgresql --config ./scripts/auth-schema.config.ts --output ./src/schema/auth.ts --yes"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sinapps/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "auth": "1.7.10",
    "better-auth": "1.7.10",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
