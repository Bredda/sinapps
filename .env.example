# Copy to .env (git-ignored).
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Local default (infra/docker-compose.yml); drizzle.config.ts falls back to it when unset.
DATABASE_URL=postgres://sinapps:sinapps@localhost:5433/sinapps

# Auth — optional in dev (defaults match infra/), required in production.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=
# KEYCLOAK_ISSUER=http://localhost:8180/realms/sinapps
# KEYCLOAK_CLIENT_ID=sinapps-web
# KEYCLOAK_CLIENT_SECRET=
# Realm role required to use the app (empty: any authenticated user).
# AUTH_REQUIRED_ROLE=sinapps-user

# Runtime configuration file (models, MCP servers). Dev default: repo-root sinapps.config.yaml.
# SINAPPS_CONFIG=/etc/sinapps/config.yaml

# Observability — off unless an OTLP endpoint is set (pnpm infra:obs listens on :4318). Any standard OTEL_* variable applies.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=sinapps-web
# Record prompts and completions on spans (PII: debugging only).
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# LOG_LEVEL=info
