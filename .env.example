# Copy to .env (git-ignored).
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Local default (infra/docker-compose.yml); drizzle.config.ts falls back to it when unset.
DATABASE_URL=postgres://sinapps:sinapps@localhost:5433/sinapps

# Auth — optional in dev (defaults match infra/), required in production.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=
# KEYCLOAK_ISSUER=http://localhost:8180/realms/sinapps
# KEYCLOAK_CLIENT_ID=sinapps-web
# KEYCLOAK_CLIENT_SECRET=
# Realm role required to use the app (empty: any authenticated user).
# AUTH_REQUIRED_ROLE=sinapps-user
