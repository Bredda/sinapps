{
  "name": "fleet-pulse-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Apps demo: a live infrastructure dashboard showing polling, drill-down, and bidirectional model context.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "watch": "cross-env INPUT=mcp-app.html vite build --watch",
    "build": "tsc --noEmit && cross-env INPUT=mcp-app.html vite build",
    "serve": "tsx --watch main.ts",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run watch\" \"npm run serve\"",
    "start": "npm run build && tsx main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
